entity User_profile {
    + email_user: PK
    --
    first_name_user
    second_name_user
    password_user
    role_user
    phone_number_client
    image_user_profile
}

entity Attribute_group {
    + id_attribute_group: PK
    --
    name_attribute_group
}

entity Attribute {
    + id_attribute: PK
    --
    name_attribute
    id_attribute_group: FK
}

entity Cart {
    + id_cart: PK
    --
    email_user: FK
}

entity Cart_product {
    + id_cart_product: PK
    --
    id_cart: FK
    id_product: FK
}

entity Category {
    + id_category: PK
    --
    name_category
}

entity Product {
    + id_product: PK
    --
    article_product
    name_product
    price_product
    url_main_image_product
    description_product
    count_product
    is_enabled
    id_category: FK
}

entity Specification {
    + id_specification: PK
    --
    value_specification
    id_attribute: FK
    id_product: FK
}

entity Product_image {
    + id_product_image: PK
    --
    url_image
    id_product: FK
}

entity Product_comment {
    + id_product_comment: PK
    --
    mark_comment
    description_comment
    id_product: FK
    email_user: FK
}

entity Image_comment {
    + id_image_comment: PK
    --
    text_comment
    id_product_comment: FK
}

entity Order_address {
    + id_order_address: PK
    --
    country
    city
    street
    house
    apartment
    postal_code
    email_user: FK
}

entity Orders {
    + id_order: PK
    --
    status
    id_order_address: FK
}

entity Order_product {
    + id_order_product: PK
    --
    id_product: FK
    id_order: FK
}

